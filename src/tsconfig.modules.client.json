{
	"extends": "../tsconfig.base.json",
	"compilerOptions": {
		"rootDir": "modules",
		"outDir": "../defaultmodules",
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"types": [],
		"alwaysStrict": false,
		"incremental": true,
		"tsBuildInfoFile": "../node_modules/.cache/tsc/modules-client.tsbuildinfo"
	},
	"//": "Browser global-script files inside default modules (Module.register entries, weatherobject/utils) -> defaultmodules/.",
