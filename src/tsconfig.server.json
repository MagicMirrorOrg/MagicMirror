{
	"extends": "../tsconfig.base.json",
	"compilerOptions": {
		"rootDir": ".",
		"outDir": "..",
		"lib": ["ES2022"],
		"types": ["node"],
		"incremental": true,
		"tsBuildInfoFile": "../node_modules/.cache/tsc/server.tsbuildinfo"
