		"js/http_fetcher.ts",
		"js/server_functions.ts",
		"js/utils.ts",
		"js/app.ts",
		"js/server.ts",
		"js/electron.ts",
		"js/node_helper.ts",
		"js/releasenotes.ts",
		"js/ip_access_control.ts",
		"js/check_config.ts",
		"js/systeminformation.ts",
		"js/alias-resolver.ts",
		"clientonly/index.ts",
		"serveronly/index.ts",
		"serveronly/watcher.ts",
		"defaultmodules/calendar/debug.ts",
		"defaultmodules/calendar/calendarfetcherutils.ts",
		"defaultmodules/calendar/calendarfetcher.ts",
		"defaultmodules/calendar/node_helper.ts",
		"defaultmodules/newsfeed/newsfeedfetcher.ts",
