{
	"extends": "../tsconfig.base.json",
	"compilerOptions": {
		"rootDir": ".",
		"outDir": "..",
		"lib": ["ES2022"],
		"types": ["node"],
		"incremental": true,
		"tsBuildInfoFile": "../node_modules/.cache/tsc/server.tsbuildinfo"
	},
	"//": "Server/Node CommonJS files. Add each migrated source file explicitly so it is never compiled by both projects (which would double-emit). Browser-only files belong in tsconfig.browser.json.",
	"files": [
		"types/node-globals.d.ts",
		"types/aliases.d.ts",
		"js/deprecated.ts",
		"js/http_fetcher.ts",
		"js/server_functions.ts",
		"js/utils.ts",
		"defaultmodules/calendar/calendarfetcherutils.ts",
		"defaultmodules/weather/provider-utils.ts",
		"defaultmodules/weather/providers/envcanada.ts",
		"defaultmodules/weather/providers/openmeteo.ts",
		"defaultmodules/weather/providers/openweathermap.ts",
		"defaultmodules/weather/providers/pirateweather.ts",
		"defaultmodules/weather/providers/smhi.ts",
		"defaultmodules/weather/providers/ukmetofficedatahub.ts",
		"defaultmodules/weather/providers/weatherapi.ts",
		"defaultmodules/weather/providers/weatherbit.ts",
		"defaultmodules/weather/providers/weatherflow.ts",
		"defaultmodules/weather/providers/weathergov.ts",
		"defaultmodules/weather/providers/yr.ts"
	]
}
